{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    },
    {
      "source": "/theos_block/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/fin_part1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fin_part1/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/slum_policies",
      "destination": "/slum_review",
      "permanent": true
    },
    {
      "source": "/slum_policies.html",
      "destination": "/slum_review",
      "permanent": true
    }
  ]
}